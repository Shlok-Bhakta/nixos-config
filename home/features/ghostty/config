# Ghostty, set up to look and behave like the old kitty config.
# tmux owns tabs, splits and scrollback, so Ghostty's are turned off.

# Look
theme = Catppuccin Mocha
font-family = CaskaydiaCove Nerd Font
font-size = 11
window-padding-x = 0
window-padding-y = 0
cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true

# No GTK chrome: no titlebar, no tab bar, no toasts, no resize overlay.
window-decoration = none
gtk-titlebar = false
window-show-tab-bar = never
resize-overlay = never
app-notifications = false

# Every window is a fresh tmux session, like kitty's `shell tmux`.
command = tmux
confirm-close-surface = false

# Keybinds: drop every default (tabs, splits, ...) and keep kitty's basics.
keybind = clear
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = shift+insert=paste_from_selection
keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+shift+plus=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1
keybind = ctrl+shift+backspace=reset_font_size
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+f5=reload_config
